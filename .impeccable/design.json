      "description": "Top-bar two-way toggle; checked side fills white.",
      "html": "<div class=\"ds-seg\"><button class=\"on\">오른손</button><button>왼손</button></div>",
      "css": ":host{--floor:#0B2340;--table:#17457A;--table-deep:#123A66;--line:#FFFFFF;--ball:#F28C28;--ink:#FFFFFF;--ink-2:#C9D8EC;--ink-3:#9DB4D3;--ok:#7FD8A6;--warn:#FF9A8A;--ease:cubic-bezier(.16,1,.3,1);}.ds-seg{display:inline-flex;border:2px solid var(--line);border-radius:999px;padding:2px;background:var(--floor);}.ds-seg button{font-family:\"Pretendard Variable\",Pretendard,system-ui,sans-serif;min-height:44px;padding:6px 14px;border:0;border-radius:999px;background:transparent;color:var(--ink-2);font-size:14px;font-weight:600;cursor:pointer;}.ds-seg button.on{background:var(--line);color:var(--floor);}.ds-seg button:focus-visible{outline:3px solid var(--ball);outline-offset:2px;}"
    },
    {
