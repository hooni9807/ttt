      "css": ":host{--floor:#0B2340;--table:#17457A;--table-deep:#123A66;--line:#FFFFFF;--ball:#F28C28;--ink:#FFFFFF;--ink-2:#C9D8EC;--ink-3:#9DB4D3;--ok:#7FD8A6;--warn:#FF9A8A;--ease:cubic-bezier(.16,1,.3,1);}.ds-ghost-btn{font-family:\"Pretendard Variable\",Pretendard,system-ui,sans-serif;display:inline-flex;align-items:center;gap:8px;min-height:48px;padding:0 20px;border-radius:999px;border:2px solid var(--line);background:var(--table);color:var(--ink);font-weight:700;cursor:pointer;}.ds-ghost-btn:hover{background:#2E5787;}.ds-ghost-btn:focus-visible{outline:3px solid var(--ball);outline-offset:3px;}"
