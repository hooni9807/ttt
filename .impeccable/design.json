      "kind": "button",
      "refersTo": "button-ball",
      "description": "Primary action: the only orange pill on a screen.",
      "html": "<button class=\"ds-ball-btn\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 16V4M6 10l6-6 6 6M4 20h16\"/></svg>스윙 영상 올리기</button>",
      "css": ":host{--floor:#0B2340;--table:#17457A;--table-deep:#123A66;--line:#FFFFFF;--ball:#F28C28;--ink:#FFFFFF;--ink-2:#C9D8EC;--ink-3:#9DB4D3;--ok:#7FD8A6;--warn:#FF9A8A;--ease:cubic-bezier(.16,1,.3,1);}.ds-ball-btn{font-family:\"Pretendard Variable\",Pretendard,system-ui,sans-serif;display:inline-flex;align-items:center;gap:10px;min-height:56px;padding:0 28px;border:0;border-radius:999px;background:var(--ball);color:var(--floor);font-size:18px;font-weight:800;cursor:pointer;box-shadow:0 6px 18px rgba(3,12,26,.35);transition:transform .2s var(--ease),box-shadow .2s var(--ease);}.ds-ball-btn:hover{transform:translateY(-1px);box-shadow:0 10px 24px rgba(3,12,26,.4);}.ds-ball-btn:active{transform:translateY(1px);}.ds-ball-btn:focus-visible{outline:3px solid var(--ball);outline-offset:3px;}"
    },
