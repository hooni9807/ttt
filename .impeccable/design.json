  "narrative": {
    "northStar": "The Table Surface",
    "overview": "The screen is a match table seen from above. A floor-navy ground holds one or more blue table tops, each framed by a white boundary line and split by a white net line; every working area sits inside one of those courts. The world rejects the default analysis-app layout of dark cards in a grid: panels are courts, dividers are painted lines, and the only warm thing on the page is the ball.\n\nThe system is dense but calm, built for one hand on a phone under bright hall lighting. Large touch targets (44px minimum, 56px for the primary action), high-contrast white-on-blue type, and tabular numerals so measurements line up. Motion is limited to the ball: it rolls along white lines on the progress rail and the scrubber, and the result view rises in once.\n\nThe 3D viewer belongs to the same world: its floor is the hall floor, its stage is a blue table top with white lines, the skeleton is drawn in white, and the impact point is the orange ball.",
    "keyCharacteristics": [
      "Floor navy ground, table blue panels, white 5px boundary and 3px net lines.",
      "Orange appears only on things you can press and on impact.",
      "Pills and circles for controls; near-square 6px corners for table tops.",
      "Single family (Pretendard), weight carries hierarchy, numbers are tabular.",
      "Status is mint (inside pro range) or coral (outside), never orange."
    ],
    "rules": [
      {
        "name": "The Ball Rule",
        "body": "Orange is the ball: it marks what can be pressed and the moment of impact. It is never a status colour, a heading colour, or decoration.",
        "section": "colors"
      },
      {
        "name": "The Painted Line Rule",
        "body": "Structure is drawn with white court lines (5px boundary, 3px net, 1px translucent hairlines), not with shadows, tinted cards, or extra background shades.",
        "section": "colors"
      },
      {
        "name": "The Advice-First Rule",
        "body": "The correction sentence is set larger and heavier than any measured number near it; the next thing to fix outranks the data.",
        "section": "typography"
      },
      {
        "name": "The Only-The-Ball-Floats Rule",
        "body": "Shadows belong to orange ball elements alone. Tables, plates, and ghost controls stay flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put every working area inside a Table Blue panel with a 5px white boundary, and split it with a 3px white net.",
      "Do reserve Ball Orange for pressable controls, focus, progress/scrub thumbs, and impact.",
      "Do use mint for inside-range and coral for outside-range, each paired with an icon and words.",
      "Do keep touch targets at 44px or larger; the primary action is 56px.",
      "Do set every number with tabular figures and its unit in smaller Ink 2.",
      "Do keep the 3D view the largest element on the result screen at every width.",
      "Do disable all animation and transition under `prefers-reduced-motion`."
    ],
    "donts": [
      "Don't build dark cards in a grid; panels are courts on a floor.",
      "Don't use orange for status, headings, or decoration.",
      "Don't add shadows to tables, plates, or ghost controls.",
      "Don't introduce a second typeface; vary weight instead."
    ]
  }
}