      "css": ":host{--floor:#0B2340;--table:#17457A;--table-deep:#123A66;--line:#FFFFFF;--ball:#F28C28;--ink:#FFFFFF;--ink-2:#C9D8EC;--ink-3:#9DB4D3;--ok:#7FD8A6;--warn:#FF9A8A;--ease:cubic-bezier(.16,1,.3,1);}.ds-select{font-family:\"Pretendard Variable\",Pretendard,system-ui,sans-serif;height:44px;padding:0 10px;border-radius:8px;border:2px solid rgba(255,255,255,.5);background:var(--table-deep);color:var(--ink);font-size:14px;}.ds-select:focus-visible{outline:3px solid var(--ball);outline-offset:3px;}"
    }
