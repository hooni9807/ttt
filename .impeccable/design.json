      "refersTo": "phase-chip",
      "description": "Backswing / impact / finish jump buttons on the net line.",
      "html": "<div class=\"ds-phases\"><button>백스윙</button><button aria-pressed=\"true\">임팩트</button><button>피니시</button></div>",
      "css": ":host{--floor:#0B2340;--table:#17457A;--table-deep:#123A66;--line:#FFFFFF;--ball:#F28C28;--ink:#FFFFFF;--ink-2:#C9D8EC;--ink-3:#9DB4D3;--ok:#7FD8A6;--warn:#FF9A8A;--ease:cubic-bezier(.16,1,.3,1);}.ds-phases{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:12px;background:var(--table);}.ds-phases button{font-family:\"Pretendard Variable\",Pretendard,system-ui,sans-serif;min-height:44px;border-radius:999px;border:2px solid var(--line);background:transparent;color:var(--ink);font-weight:700;cursor:pointer;}.ds-phases button:hover{background:rgba(255,255,255,.1);}.ds-phases button[aria-pressed=true]{background:var(--line);color:var(--floor);}.ds-phases button:focus-visible{outline:3px solid var(--ball);outline-offset:3px;}"
    },
    {
      "name": "Table Panel",
      "kind": "card",
      "refersTo": "table-panel",
      "description": "The court: blue top, 5px white boundary, 3px net, centre-line stubs.",
      "html": "<section class=\"ds-table\"><div class=\"ds-half\"><h2>다음 연습에서 고칠 것</h2></div><div class=\"ds-net\"></div><div class=\"ds-half\"><p>이렇게 찍어 주세요</p></div></section>",
      "css": ":host{--floor:#0B2340;--table:#17457A;--table-deep:#123A66;--line:#FFFFFF;--ball:#F28C28;--ink:#FFFFFF;--ink-2:#C9D8EC;--ink-3:#9DB4D3;--ok:#7FD8A6;--warn:#FF9A8A;--ease:cubic-bezier(.16,1,.3,1);}.ds-table{font-family:\"Pretendard Variable\",Pretendard,system-ui,sans-serif;position:relative;background:var(--table);border:5px solid var(--line);border-radius:6px;color:var(--ink);}.ds-table::before,.ds-table::after{content:'';position:absolute;left:50%;width:2px;height:22px;margin-left:-1px;background:var(--line);opacity:.7;}.ds-table::before{top:0;}.ds-table::after{bottom:0;}.ds-net{height:3px;background:var(--line);}.ds-half{padding:32px 22px;}.ds-half h2{margin:0;font-size:18px;font-weight:800;}.ds-half p{margin:0;color:var(--ink-2);}"
    },
    {
      "name": "Ball on the Net",
      "kind": "custom",
      "refersTo": "",
      "description": "Progress rail and scrubber: white net line with a rolling orange ball.",
      "html": "<div class=\"ds-rail\" style=\"--p:.42\"><div class=\"ds-fill\"></div><div class=\"ds-ball\"></div></div>",
      "css": ":host{--floor:#0B2340;--table:#17457A;--table-deep:#123A66;--line:#FFFFFF;--ball:#F28C28;--ink:#FFFFFF;--ink-2:#C9D8EC;--ink-3:#9DB4D3;--ok:#7FD8A6;--warn:#FF9A8A;--ease:cubic-bezier(.16,1,.3,1);}.ds-rail{position:relative;height:22px;width:280px;}.ds-rail::before{content:'';position:absolute;left:0;right:0;top:10px;height:3px;background:rgba(255,255,255,.3);}.ds-fill{position:absolute;left:0;top:10px;height:3px;width:calc(var(--p)*100%);background:var(--line);}.ds-ball{position:absolute;top:2px;left:calc(var(--p)*(100% - 18px));width:18px;height:18px;border-radius:50%;background:var(--ball);box-shadow:0 3px 8px rgba(3,12,26,.45);}"
